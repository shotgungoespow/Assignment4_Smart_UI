<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Assignment4_Smart_UI.Views.Register_Page"
             Title="Register_Page">
    
    <ScrollView>
        <Grid
            Padding="24"
            VerticalOptions="Center"
            HorizontalOptions="Fill">

            <Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="28"
                MaximumWidthRequest="420"
                HorizontalOptions="Center">

                <VerticalStackLayout Spacing="18">

                    <!-- Header -->
                    <VerticalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center"
                        Margin="0,0,0,8">

                        <Border
                            BackgroundColor="#DBEAFE"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 30"
                            HeightRequest="64"
                            WidthRequest="64"
                            Padding="16"
                            HorizontalOptions="Center">

                            <Label
                                Text="👤"
                                FontSize="28"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>
                        </Border>

                        <Label
                            Text="Create Account"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="#0F172A"
                            HorizontalTextAlignment="Center"/>

                        <Label
                            Text="Sign up to get started"
                            FontSize="14"
                            TextColor="#64748B"
                            HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="16"
                    RowDefinitions="Auto">

                        <!-- Email -->
                        <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="6">

                            <Label
                            Text="Email"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#334155"/>

                            <Entry
                            x:Name="EmailEntry"
                            Placeholder="Enter your email"
                            Keyboard="Email"
                            FontSize="14"
                            TextColor="#0F172A"
                            PlaceholderColor="#94A3B8"
                            BackgroundColor="Transparent"
                            ClearButtonVisibility="WhileEditing"
                            ReturnType="Next"/>

                            <Label
                            x:Name="EmailError"
                            Text=""
                            FontSize="12"
                            TextColor="#DC2626"
                            MinimumHeightRequest="16"/>
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6">

                            <Label
                            Text="Password"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#334155"/>

                            <Entry
                            x:Name="PasswordEntry"
                            Placeholder="Create password"
                            IsPassword="True"
                            FontSize="14"
                            TextColor="#0F172A"
                            PlaceholderColor="#94A3B8"
                            BackgroundColor="Transparent"
                            ReturnType="Next"/>

                            <Label
                            x:Name="PasswordError"
                            Text=""
                            FontSize="12"
                            TextColor="#DC2626"
                            MinimumHeightRequest="16"/>
                        </VerticalStackLayout>

                    </Grid>

                    <!-- Confirm password -->
                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Confirm Password"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#334155"/>

                        <Entry
                            x:Name="ConfirmPasswordEntry"
                            Placeholder="Confirm your password"
                            IsPassword="True"
                            FontSize="14"
                            TextColor="#0F172A"
                            PlaceholderColor="#94A3B8"
                            BackgroundColor="Transparent"
                            ReturnType="Done"/>

                        <Label
                            x:Name="ConfirmPasswordError"
                            Text=""
                            FontSize="12"
                            TextColor="#DC2626"
                            MinimumHeightRequest="16"/>
                    </VerticalStackLayout>
                    
                    <!-- Register button -->
                    <Button
                        x:Name="RegisterButton"
                        Text="Create Account"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#2563EB"
                        CornerRadius="10"
                        HeightRequest="48"
                        Clicked="OnRegisterClicked"/>

                    <!-- General status -->
                    <Label
                        x:Name="StatusLabel"
                        Text=""
                        FontSize="13"
                        TextColor="#DC2626"
                        HorizontalTextAlignment="Center"
                        IsVisible="False"/>

                    <!-- Login link -->
                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="4">

                        <Label
                            Text="Already have an account?"
                            FontSize="12"
                            TextColor="#64748B"
                            VerticalTextAlignment="Center"/>

                        <Label
                            Text="Login"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#2563EB"
                            VerticalTextAlignment="Center">

                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnLoginTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>